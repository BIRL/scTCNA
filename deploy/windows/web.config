<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS site that forwards everything to the scTCNA app on 127.0.0.1:8000 (README_WINDOWS.md).
     Needs the URL Rewrite and Application Request Routing modules, with the ARR proxy enabled. -->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <clear />
                <rule name="http to https" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" />
                </rule>
                <rule name="scTCNA app" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
        <security>
            <requestFiltering>
                <!-- heatmap requests and page URLs carry up to 200 gene symbols in the query string -->
                <requestLimits maxQueryString="8192" />
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
